set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(DEFINED ENV{GCC_TOOLCHAIN_14_3_1})
  set(_gcc_bin "$ENV{GCC_TOOLCHAIN_14_3_1}/")
endif()
find_program(CMAKE_C_COMPILER NAMES arm-none-eabi-gcc HINTS "${_gcc_bin}")
find_program(CMAKE_CXX_COMPILER NAMES arm-none-eabi-g++ HINTS "${_gcc_bin}")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-m55 -mthumb -mfloat-abi=hard -fpermitted-flt-eval-methods=c11 -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -fno-use-cxa-atexit")
set(CMAKE_ASM_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
