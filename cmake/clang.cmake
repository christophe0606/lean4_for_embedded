set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{CLANG_TOOLCHAIN_23_1_0})
  message(FATAL_ERROR "Register ATfE 23.1.0 with CLANG_TOOLCHAIN_23_1_0")
endif()
find_program(_clang_c NAMES clang HINTS "$ENV{CLANG_TOOLCHAIN_23_1_0}" NO_DEFAULT_PATH REQUIRED)
find_program(_clang_cxx NAMES clang++ HINTS "$ENV{CLANG_TOOLCHAIN_23_1_0}" NO_DEFAULT_PATH REQUIRED)
set(CMAKE_C_COMPILER "${_clang_c}")
set(CMAKE_CXX_COMPILER "${_clang_cxx}")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_C_COMPILER_TARGET arm-none-eabi)
set(CMAKE_CXX_COMPILER_TARGET arm-none-eabi)
set(CMAKE_ASM_COMPILER_TARGET arm-none-eabi)
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-m55 -mfpu=fpv5-d16 -mfloat-abi=hard -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -fno-use-cxa-atexit")
set(CMAKE_ASM_FLAGS_INIT "-mcpu=cortex-m55 -mfpu=fpv5-d16 -mfloat-abi=hard")
